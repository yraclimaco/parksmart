# Copy this file to .env and fill in your own values.
OPENAI_API_KEY=
DATA_PATH=data/raw
MODEL_NAME=baseline

# Routes (Issue #25, docs/routing.md). The backend reads these from the shell or
# Lambda environment; there is no .env loader. Keep the key out of Git and out of
# any VITE_ variable.
# Blank provider: ors if ORS_API_KEY is set, otherwise the public OSRM servers.
# Set to none to turn routes off.
PARKSMART_ROUTING_PROVIDER=
ORS_API_KEY=

# Extra browser origins allowed to call the API, comma-separated exact origins
# (e.g. the deployed Amplify URL). Localhost ports 3000/5173 are always allowed.
PARKSMART_CORS_ORIGINS=
