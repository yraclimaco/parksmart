# Copy to .env.local (ignored by Git) to override. Never put secrets here:
# every VITE_ variable is bundled into the public website.

# FastAPI backend base URL. Default when unset: http://127.0.0.1:8000
VITE_API_BASE_URL="http://127.0.0.1:8000"

# "api" sends searches to the backend's POST /recommendations; anything else
# (or unset) uses the built-in, clearly labeled sample data.
VITE_RECOMMENDATION_SOURCE="sample"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
